#!/usr/bin/env bash

if [[ "${1:-}" == "--meta" ]]; then
    echo "mount and manage encrypted persistent storage"
    exit 0
fi

set -euo pipefail

XMNT_NAME="xmnt"
XMNT_MAPPER="DATA"
XMNT_LUKS_DEVICE="/dev/disk/by-uuid/5be0d791-460b-447a-8b71-3092d94c1a84"
XMNT_MAPPER_DEVICE="/dev/mapper/DATA"

declare -Ar XMNT_MOUNTPOINTS=(
    [data]="/mnt/data"
    [vm]="/mnt/data/vm"
)

declare -Ar XMNT_SUBVOLS=(
    [data]="@"
    [vm]="@vm"
)

declare -Ar XMNT_CONTROLLERS=(
    [data]="DATA"
    [vm]="DATA"
)

declare -Ar XMNT_GROUPS=(
    [persistent]="data vm"
    [both]="data vm"
    [all]="data vm"
)

die() {
    printf '%s: %s\n' "$XMNT_NAME" "$*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage:
  xmnt mount <name>
  xmnt mount <group>
  xmnt <name>
  xmnt <group>

  xmnt umount <name>
  xmnt umount <group>

  xmnt open
  xmnt close
  xmnt list
  xmnt status [--verbose]
  xmnt doctor

Names:
  data
  vm

Groups:
  persistent
  both
  all

Options:
  -h, --help
  --meta
EOF
}

is_mount_name() {
    [[ -n "${XMNT_MOUNTPOINTS[$1]+x}" ]]
}

is_mount_group() {
    [[ -n "${XMNT_GROUPS[$1]+x}" ]]
}

sorted_mount_names() {
    mapfile -t XMNT_SORTED_NAMES < <(printf '%s\n' "${!XMNT_MOUNTPOINTS[@]}" | sort)
}

sorted_group_names() {
    mapfile -t XMNT_SORTED_GROUPS < <(printf '%s\n' "${!XMNT_GROUPS[@]}" | sort)
}

unlock() {
    if [[ -e "$XMNT_MAPPER_DEVICE" ]]; then
        printf '✓ %s already unlocked\n' "$XMNT_MAPPER"
        return 0
    fi

    printf 'Unlocking %s...\n' "$XMNT_MAPPER"
    sudo cryptsetup open "$XMNT_LUKS_DEVICE" "$XMNT_MAPPER"
    printf '✓ Unlocked %s\n' "$XMNT_MAPPER"
}

container_has_active_mounts() {
    local name

    for name in "${!XMNT_MOUNTPOINTS[@]}"; do
        if mountpoint -q "${XMNT_MOUNTPOINTS[$name]}"; then
            return 0
        fi
    done

    return 1
}

active_mount_names() {
    local name

    for name in "${!XMNT_MOUNTPOINTS[@]}"; do
        if mountpoint -q "${XMNT_MOUNTPOINTS[$name]}"; then
            printf '%s\n' "$name"
        fi
    done
}

maybe_close() {
    if container_has_active_mounts; then
        return 0
    fi

    if [[ ! -e "$XMNT_MAPPER_DEVICE" ]]; then
        return 0
    fi

    printf 'Closing %s...\n' "$XMNT_MAPPER"
    sudo cryptsetup close "$XMNT_MAPPER"
    printf '✓ Closed %s\n' "$XMNT_MAPPER"
}

close_container() {
    local -a active=()
    mapfile -t active < <(active_mount_names)

    if (( ${#active[@]} )); then
        die "cannot close while mounted: ${active[*]}"
    fi

    if [[ ! -e "$XMNT_MAPPER_DEVICE" ]]; then
        printf '✓ %s already closed\n' "$XMNT_MAPPER"
        return 0
    fi

    printf 'Closing %s...\n' "$XMNT_MAPPER"
    sudo cryptsetup close "$XMNT_MAPPER"
    printf '✓ Closed %s\n' "$XMNT_MAPPER"
}

mount_one_no_unlock() {
    local name="$1"

    is_mount_name "$name" || die "unknown mount: $name"

    local target="${XMNT_MOUNTPOINTS[$name]}"
    local subvol="${XMNT_SUBVOLS[$name]}"

    if mountpoint -q "$target"; then
        printf '✓ %s already mounted\n' "$name"
        return 0
    fi

    sudo mkdir -p "$target"

    printf 'Mounting %s...\n' "$name"
    sudo mount -o "compress=zstd:3,noatime,subvol=$subvol" "$XMNT_MAPPER_DEVICE" "$target"
    printf '✓ Mounted %s\n' "$name"
}

mount_one() {
    local name="$1"

    unlock
    mount_one_no_unlock "$name"
}

mount_group() {
    local group="$1"

    is_mount_group "$group" || die "unknown group: $group"

    unlock

    local -a names=()
    read -r -a names <<<"${XMNT_GROUPS[$group]}"

    local name
    for name in "${names[@]}"; do
        mount_one_no_unlock "$name"
    done
}

umount_one() {
    local name="$1"

    is_mount_name "$name" || die "unknown mount: $name"

    local target="${XMNT_MOUNTPOINTS[$name]}"

    if ! mountpoint -q "$target"; then
        printf '✓ %s already unmounted\n' "$name"
        maybe_close
        return 0
    fi

    printf 'Unmounting %s...\n' "$name"
    sudo umount "$target"
    printf '✓ Unmounted %s\n' "$name"

    maybe_close
}

umount_group() {
    local group="$1"

    is_mount_group "$group" || die "unknown group: $group"

    local -a names=()
    read -r -a names <<<"${XMNT_GROUPS[$group]}"

    local i
    for ((i=${#names[@]}-1; i>=0; i--)); do
        umount_one "${names[$i]}"
    done
}

list_mounts() {
    local -a names=()
    sorted_mount_names
    names=("${XMNT_SORTED_NAMES[@]}")

    printf '%-10s %-12s %-24s %-8s %s\n' "NAME" "CONTAINER" "MOUNTPOINT" "SUBVOL" "SOURCE"

    local name
    for name in "${names[@]}"; do
        printf '%-10s %-12s %-24s %-8s %s\n' \
            "$name" \
            "${XMNT_CONTROLLERS[$name]}" \
            "${XMNT_MOUNTPOINTS[$name]}" \
            "${XMNT_SUBVOLS[$name]}" \
            "$XMNT_MAPPER_DEVICE"
    done
}

status_mounts() {
    local verbose=false
    case "${1:-}" in
        ""|-v|--verbose)
            [[ "${1:-}" != "" ]] && verbose=true
            ;;
        *)
            die "unknown option for status: $1"
            ;;
    esac

    local -a names=()
    sorted_mount_names
    names=("${XMNT_SORTED_NAMES[@]}")

    if $verbose; then
        printf '%-10s %-12s %-24s %-8s %s\n' "NAME" "STATUS" "MOUNTPOINT" "SUBVOL" "SOURCE"
    else
        printf '%-10s %-12s %s\n' "NAME" "STATUS" "MOUNTPOINT"
    fi

    local name target state
    for name in "${names[@]}"; do
        target="${XMNT_MOUNTPOINTS[$name]}"
        if mountpoint -q "$target"; then
            state="mounted"
        else
            state="not mounted"
        fi

        if $verbose; then
            printf '%-10s %-12s %-24s %-8s %s\n' \
                "$name" \
                "$state" \
                "$target" \
                "${XMNT_SUBVOLS[$name]}" \
                "$XMNT_MAPPER_DEVICE"
        else
            printf '%-10s %-12s %s\n' \
                "$name" \
                "$state" \
                "$target"
        fi
    done
}

doctor() {
    printf 'Container:\n'
    if [[ -e "$XMNT_MAPPER_DEVICE" ]]; then
        printf '  unlocked\n'
    else
        printf '  locked\n'
    fi

    printf '\nMounts:\n'
    status_mounts --verbose

    printf '\nFilesystem:\n'
    if command -v findmnt >/dev/null 2>&1 && mountpoint -q "${XMNT_MOUNTPOINTS[data]}"; then
        findmnt -no FSTYPE,OPTIONS --target "${XMNT_MOUNTPOINTS[data]}"
    else
        printf '  unavailable\n'
    fi

    printf '\nFree space:\n'
    if mountpoint -q "${XMNT_MOUNTPOINTS[data]}"; then
        df -h "${XMNT_MOUNTPOINTS[data]}"
    else
        printf '  unavailable\n'
    fi
}

main() {
    case "${1:-}" in
        -h|--help|help|"")
            usage
            ;;
        data|vm)
            mount_one "$1"
            ;;
        persistent|both|all)
            mount_group "$1"
            ;;
        mount)
            shift
            case "${1:-}" in
                data|vm)
                    mount_one "$1"
                    ;;
                persistent|both|all)
                    mount_group "$1"
                    ;;
                *)
                    usage
                    exit 1
                    ;;
            esac
            ;;
        umount|unmount)
            shift
            case "${1:-}" in
                data|vm)
                    umount_one "$1"
                    ;;
                persistent|both|all)
                    umount_group "$1"
                    ;;
                *)
                    usage
                    exit 1
                    ;;
            esac
            ;;
        open)
            unlock
            ;;
        close)
            close_container
            ;;
        list)
            list_mounts
            ;;
        status)
            shift
            status_mounts "${1:-}"
            ;;
        doctor)
            doctor
            ;;
        *)
            die "unknown command: $1"
            ;;
    esac
}

main "$@"
