#!/usr/bin/env bash

# metadata
XMETA="compile and run C++ with sanitizers enabled"

if [[ "${1:-}" == "--meta" ]]; then
    echo "$XMETA"
    exit 0
fi

set -eu

mkdir -p build
rm -f build/main

if [ "$#" -eq 0 ]; then
    if [ ! -f main.cpp ]; then
        echo "[xclang-sanitize] error: no input files; main.cpp not found"
        exit 1
    fi

    set -- main.cpp
fi

echo "[xclang-sanitize] compiling: $*"
echo "[xclang-sanitize] sanitizers: address,undefined"

clang++ \
    -std=c++23 \
    -Wall \
    -Wextra \
    -Wpedantic \
    -fcolor-diagnostics \
    -fsanitize=address,undefined \
    -g \
    "$@" \
    -o build/main

echo "[xclang-sanitize] build succeeded"
echo "[xclang-sanitize] running: ./build/main"

./build/main