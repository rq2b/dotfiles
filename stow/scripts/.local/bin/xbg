#!/usr/bin/env bash
set -euo pipefail

# metadata
XMETA="apply per-monitor wallpapers using swaybg"

if [[ "${1:-}" == "--meta" ]]; then
    echo "$XMETA"
    exit 0
fi

pkill -x swaybg || true

HORIZONTAL="DP-1"
VERTICAL=$(hyprctl monitors -j | jq -r '
    .[]
    | select(.description=="LG Electronics LG FULL HD 0x01010101")
    | .name
')

uwsm-app -- swaybg \
    -o "$HORIZONTAL" \
    -i "$HOME/dotfiles/stow/wallpapers/.config/omarchy/backgrounds/hinterlands/horizontal-00.jpg" \
    -m fill \
    >/dev/null 2>&1 &

disown

uwsm-app -- swaybg \
    -o "$VERTICAL" \
    -i "$HOME/dotfiles/stow/wallpapers/.config/omarchy/backgrounds/hinterlands/vertical-11.jpg" \
    -m fill \
    >/dev/null 2>&1 &

disown
