#!/usr/bin/env bash

set -Eeuo pipefail

XMETA="mount and manage encrypted persistent storage"

if [[ "${1:-}" == "--meta" ]]; then
    echo "$XMETA"
    exit 0
fi

DEVICE="/dev/mapper/DATA"
LUKS_DEVICE="/dev/nvme1n1p1"
MAPPER_NAME="DATA"

declare -Ar MOUNTPOINT=(
    [data]="/mnt/data"
    [vm]="/mnt/data/vm"
)

declare -Ar SUBVOL=(
    [data]="@"
    [vm]="@vm"
)

declare -Ar MOUNT_GROUPS=(
    [persistent]="data vm"
    [both]="data vm"
    [all]="data vm"
)

die() {
    echo "xmnt: $*" >&2
    exit 1
}

unlock() {
    [[ -e "$DEVICE" ]] && return

    echo "Unlocking $MAPPER_NAME..."
    sudo cryptsetup open "$LUKS_DEVICE" "$MAPPER_NAME"
}

maybe_lock() {
    local target

    # Don't close if anything is still mounted.
    for target in "${MOUNTPOINT[@]}"; do
        if mountpoint -q "$target"; then
            return
        fi
    done

    # Already closed.
    [[ -e "$DEVICE" ]] || return

    echo "Locking $MAPPER_NAME..."
    sudo cryptsetup close "$MAPPER_NAME"
}

exists() {
    [[ -n "${MOUNTPOINT[$1]+x}" ]]
}

mount_target() {
    local name="$1"

    exists "$name" || die "Unknown mount: $name"

    local target="${MOUNTPOINT[$name]}"
    local subvol="${SUBVOL[$name]}"

    if mountpoint -q "$target"; then
        echo "✓ $name already mounted"
        return
    fi

    sudo mkdir -p "$target"

    echo "Mounting $name..."

    sudo mount \
        -o "compress=zstd:3,noatime,subvol=$subvol" \
        "$DEVICE" \
        "$target"

    echo "✓ Mounted $name"
}

mount_group() {
    local group="$1"

    [[ -n "${MOUNT_GROUPS[$group]+x}" ]] || die "Unknown group: $group"

    unlock

    for target in ${MOUNT_GROUPS[$group]}; do
        mount_target "$target"
    done
}

umount_target() {
    local name="$1"

    exists "$name" || die "Unknown mount: $name"

    local target="${MOUNTPOINT[$name]}"

    if ! mountpoint -q "$target"; then
        echo "✓ $name already unmounted"
        return
    fi

    echo "Unmounting $name..."
    sudo umount "$target"
    echo "✓ Unmounted $name"

    maybe_lock
}

umount_group() {
    local group="$1"

    [[ -n "${MOUNT_GROUPS[$group]+x}" ]] || die "Unknown group: $group"

    # reverse order
    local mounts=(${MOUNT_GROUPS[$group]})

    for ((i=${#mounts[@]}-1; i>=0; i--)); do
        umount_target "${mounts[$i]}"
    done
}

status() {
    printf "%-10s %-12s %s\n" "NAME" "STATUS" "MOUNTPOINT"

    for name in $(printf '%s\n' "${!MOUNTPOINT[@]}" | sort); do
        if mountpoint -q "${MOUNTPOINT[$name]}"; then
            state="mounted"
        else
            state="not mounted"
        fi

        printf "%-10s %-12s %s\n" \
            "$name" \
            "$state" \
            "${MOUNTPOINT[$name]}"
    done
}

list() {
    printf "%-10s %-25s %s\n" "NAME" "MOUNTPOINT" "SUBVOL"

    for name in $(printf '%s\n' "${!MOUNTPOINT[@]}" | sort); do
        printf "%-10s %-25s %s\n" \
            "$name" \
            "${MOUNTPOINT[$name]}" \
            "${SUBVOL[$name]}"
    done
}

usage() {
cat <<EOF
Usage:
  xmnt data
  xmnt vm
  xmnt persistent
  xmnt both
  xmnt all

  xmnt list
  xmnt status

  xmnt umount data
  xmnt umount vm
  xmnt umount persistent
  xmnt umount all

Options:
  --help     Show this help
  --meta     Print metadata description
EOF
}

case "${1:-}" in
    data|vm)
        unlock
        mount_target "$1"
        ;;

    persistent|both|all)
        mount_group "$1"
        ;;

    status)
        status
        ;;

    list)
        list
        ;;

    umount)
        shift

        case "${1:-}" in
            data|vm)
                umount_target "$1"
                ;;
            persistent|both|all)
                umount_group "$1"
                ;;
            *)
                usage
                exit 1
                ;;
        esac
        ;;

    -h|--help|help|"")
        usage
        ;;

    *)
        die "Unknown command '$1'"
        ;;
esac
