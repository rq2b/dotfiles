#!/usr/bin/env bash

set -euo pipefail

BASE="/home/staging/Syncthing/ITStep/Media/gpt-context"
COLD="$BASE/cold"

show_help() {
    cat <<EOF
Usage:
  ctx
  ctx <name>
  ctx <name.ext>
  ctx <name> <ext>

Examples:
  ctx
  ctx notes
  ctx notes.md
  ctx notes md
  cat file.py | ctx auth py
EOF
}

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

# Fail fast if base directory does not exist
if [[ ! -d "$BASE" ]]; then
    echo "Base directory does not exist:"
    echo "$BASE"
    exit 1
fi

# Create archive directory if missing
mkdir -p "$COLD"

TIMESTAMP="$(date +%Y%m%d_%H%M%S)"

NAME=""
EXT="txt"

# Argument parsing
if [[ $# -eq 0 ]]; then
    :
elif [[ $# -eq 1 ]]; then
    INPUT="$1"

    BASENAME="$(basename -- "$INPUT")"

    if [[ "$BASENAME" == *.* ]]; then
        NAME="${BASENAME%.*}"
        EXT="${BASENAME##*.}"
    else
        NAME="$BASENAME"
    fi
elif [[ $# -eq 2 ]]; then
    NAME="$(basename -- "$1")"
    EXT="$2"
else
    echo "Too many arguments."
    exit 1
fi

# Construct filename
if [[ -z "$NAME" ]]; then
    FILENAME="${TIMESTAMP}.${EXT}"
else
    FILENAME="${TIMESTAMP}_${NAME}.${EXT}"
fi

TARGET="$BASE/$FILENAME"

# Move existing hot files into cold/
find "$BASE" \
    -maxdepth 1 \
    -type f \
    ! -name '.*' \
    -exec mv {} "$COLD"/ \;

# Input priority:
# 1. stdin
# 2. clipboard
if [ -p /dev/stdin ]; then
    cat > "$TARGET"
else
    CLIP="$(
        wl-paste 2>/dev/null ||
        xclip -selection clipboard -o 2>/dev/null ||
        true
    )"

    if [[ -z "$CLIP" ]]; then
        echo "No stdin or clipboard content."
        exit 1
    fi

    printf "%s" "$CLIP" > "$TARGET"
fi

# Open Nautilus
nautilus "$BASE" >/dev/null 2>&1 &

echo "$TARGET"