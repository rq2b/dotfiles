#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage:
    render-queue JOB [JOB ...] [-- render-job arguments...]

Examples:
    render-queue \
        01-right-to-left \
        02-top-down \
        03-bottom-up

    render-queue \
        01-right-to-left \
        02-top-down \
        -- \
        --end-frame 500
EOF
}

[[ $# -gt 0 ]] || {
    usage
    exit 1
}

jobs=()
render_args=()

while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then
        shift
        render_args=("$@")
        break
    fi

    jobs+=("$1")
    shift
done

for job in "${jobs[@]}"; do
    echo
    echo "========================================"
    echo "Starting job: $job"
    echo "========================================"
    echo

    render-job "${render_args[@]}" "$job"

    session="render_$job"

    until tmux has-session -t "$session" 2>/dev/null; do
        sleep 0.1
    done

    tmux attach -t "$session"

    echo
    echo "Proceeding to the next job in 10 seconds."
    echo "Press Ctrl+C to stop the queue."
    echo "Press Enter to continue immediately."

    read -r -t 10 || true
done

echo
echo "Queue complete."
