#!/usr/bin/env bash

# metadata
XMETA="archive stdin or clipboard into GPT context storage"

if [[ "${1:-}" == "--meta" ]]; then
    echo "$XMETA"
    exit 0
fi

set -euo pipefail

BASE="$HOME/Syncthing/core/90 - Archive/Context Exchange"

show_help() {
    cat <<EOF
Usage:
  ctx <ext>
  ctx <name parts...> <ext>
  ctx --open

Examples:
  ctx txt
  ctx notes md
  ctx auth util py
  ctx ctx util sh
  cat file.py | ctx auth handler py
EOF
}

ALLOWED_EXTENSIONS=(
    txt md rst
    json yaml yml toml ini conf
    py pyw sh bash zsh fish
    c h cpp hpp cc
    js ts jsx tsx
    html css scss
    java kt rs go
    diff patch log tree
    csv xml sql
)

is_allowed_extension() {
    local ext="$1"

    for allowed in "${ALLOWED_EXTENSIONS[@]}"; do
        [[ "$allowed" == "$ext" ]] && return 0
    done

    return 1
}

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

# Open context directory and exit
if [[ "${1:-}" == "--open" ]]; then
    nautilus "$BASE" >/dev/null 2>&1 &
    exit 0
fi

# Base directory must exist
if [[ ! -d "$BASE" ]]; then
    echo "Base directory does not exist:"
    echo "$BASE"
    exit 1
fi

# Extension is required
if [[ $# -eq 0 ]]; then
    echo "Extension is required."
    echo
    show_help
    exit 1
fi

TIMESTAMP="$(date +%Y%m%d_%H%M%S)"

# Last argument is the extension
EXT="${!#}"
EXT="${EXT,,}"

if ! is_allowed_extension "$EXT"; then
    echo "Refusing to save file."
    echo "Unknown or disallowed extension: '$EXT'"
    echo
    echo "Allowed extensions:"
    printf '  %s\n' "${ALLOWED_EXTENSIONS[@]}"
    exit 1
fi

# Everything before the extension becomes the filename suffix
NAME=""

if [[ $# -gt 1 ]]; then
    NAME="${*:1:$#-1}"
    NAME="${NAME// /-}"
    NAME="${NAME,,}"

    # Replace anything outside the safe filename set with '-'
    NAME="$(printf '%s' "$NAME" | sed 's/[^a-z0-9._-]/-/g; s/-\{2,\}/-/g; s/^-*//; s/-*$//')"
fi

FILENAME="${TIMESTAMP}"
[[ -n "$NAME" ]] && FILENAME+="_${NAME}"
FILENAME+=".${EXT}"

TARGET="$BASE/$FILENAME"

# Input priority:
# 1. stdin
# 2. clipboard
if [[ -p /dev/stdin ]]; then
    cat > "$TARGET"
else
    if ! CLIP="$(
        wl-paste 2>/dev/null ||
        xclip -selection clipboard -o 2>/dev/null
    )"; then
        echo "No stdin or clipboard content."
        exit 1
    fi

    [[ -n "$CLIP" ]] || {
        echo "No stdin or clipboard content."
        exit 1
    }

    printf '%s' "$CLIP" > "$TARGET"
fi

# Open Nautilus
nautilus "$BASE" >/dev/null 2>&1 &

echo "$TARGET"
