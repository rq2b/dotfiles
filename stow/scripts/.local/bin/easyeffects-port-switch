#!/usr/bin/env bash
set -euo pipefail

SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"
last=""

get_port() {
    pactl list sinks | awk -v sink="$SINK" '
        $1 == "Name:" && $2 == sink { found=1 }
        found && /Active Port:/ { print $3; exit }
    '
}

while true; do
    port="$(get_port)"

    if [[ "$port" != "$last" ]]; then
        case "$port" in
            analog-output-lineout)
                easyeffects -l speakers-mono
                ;;

            analog-output-headphones)
                easyeffects -l headphones-stereo
                ;;
        esac

        last="$port"
    fi

    sleep 1
done
