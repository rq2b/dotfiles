#!/usr/bin/env bash

set -euo pipefail

BASE="/home/staging/Syncthing/ITStep/Media/gpt-context"
COLD="$BASE/cold"

show_help() {
    cat <<EOF
Usage:
  ctx <ext>
  ctx <name parts...> <ext>

Examples:
  ctx txt
  ctx notes md
  ctx auth util py
  ctx ctx util sh
  cat file.py | ctx auth handler py
EOF
}

ALLOWED_EXTENSIONS=(
    txt md rst
    json yaml yml toml ini conf
    py pyw sh bash zsh fish
    c h cpp hpp cc
    js ts jsx tsx
    html css scss
    java kt rs go
    diff patch log tree
    csv xml sql
)

is_allowed_extension() {
    local ext="$1"

    for allowed in "${ALLOWED_EXTENSIONS[@]}"; do
        if [[ "$allowed" == "$ext" ]]; then
            return 0
        fi
    done

    return 1
}

# Help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

# Fail fast if base directory does not exist
if [[ ! -d "$BASE" ]]; then
    echo "Base directory does not exist:"
    echo "$BASE"
    exit 1
fi

# Create archive directory if missing
mkdir -p "$COLD"

TIMESTAMP="$(date +%Y%m%d_%H%M%S)"

NAME=""
EXT=""

# Extension is now required
if [[ $# -eq 0 ]]; then
    echo "Extension is required."
    echo
    show_help
    exit 1
fi

# Last argument = extension
EXT="${!#}"

# Normalize extension
EXT="$(printf '%s' "$EXT" | tr '[:upper:]' '[:lower:]')"

# Validate extension
if ! is_allowed_extension "$EXT"; then
    echo "Refusing to save file."
    echo "Unknown or disallowed extension: '$EXT'"
    echo
    echo "Allowed extensions:"
    printf '  %s\n' "${ALLOWED_EXTENSIONS[@]}"
    exit 1
fi

# Everything except last arg = filename
if [[ $# -gt 1 ]]; then
    PARTS=("${@:1:$#-1}")

    NAME="$(printf '%s ' "${PARTS[@]}")"

    # Trim trailing space
    NAME="${NAME% }"

    # Normalize
    NAME="${NAME// /-}"

    # Lowercase
    NAME="$(printf '%s' "$NAME" | tr '[:upper:]' '[:lower:]')"

    # Remove dangerous characters
    NAME="$(printf '%s' "$NAME" | sed 's/[^a-zA-Z0-9._-]/-/g')"

    # Prevent path traversal
    NAME="$(basename -- "$NAME")"

    # Collapse repeated dashes
    NAME="$(printf '%s' "$NAME" | sed 's/-\{2,\}/-/g')"

    # Remove leading/trailing dashes
    NAME="$(printf '%s' "$NAME" | sed 's/^-\+//; s/-\+$//')"
fi

# Construct filename
if [[ -z "$NAME" ]]; then
    FILENAME="${TIMESTAMP}.${EXT}"
else
    FILENAME="${TIMESTAMP}_${NAME}.${EXT}"
fi

TARGET="$BASE/$FILENAME"

# Move existing hot files into cold/
find "$BASE" \
    -maxdepth 1 \
    -type f \
    ! -name '.*' \
    -exec mv {} "$COLD"/ \;

# Input priority:
# 1. stdin
# 2. clipboard
if [ -p /dev/stdin ]; then
    cat > "$TARGET"
else
    CLIP="$(
        wl-paste 2>/dev/null ||
        xclip -selection clipboard -o 2>/dev/null ||
        true
    )"

    if [[ -z "$CLIP" ]]; then
        echo "No stdin or clipboard content."
        exit 1
    fi

    printf "%s" "$CLIP" > "$TARGET"
fi

# Open Nautilus
nautilus "$BASE" >/dev/null 2>&1 &

echo "$TARGET"